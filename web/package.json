{
  "name": "nui",
  "version": "0.0.1",
  "description": "UI Web Components",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.prod.json",
    "build:dev": "tsc -p tsconfig.dev.json",
    "watch:dev": "tsc -w -p tsconfig.dev.json",
